#!/usr/bin/env bash
# usage: pixi run run   (or `pixi shell`, then ./run)
# Must be launched inside the pixi environment so python and Rscript resolve.

if [ -z "$PIXI_ENVIRONMENT_NAME" ]; then
  echo "Run this through pixi: 'pixi run run'" >&2
  exit 1
fi

# Don't forget to set your environment variables in .env
if [ -f .env ]
then
  export $(cat .env | xargs)
fi

script_dir=$PWD

for pipeline in calibration sampling constraining; do
    cd ${script_dir}/input/${pipeline}
    file_array=( $(\ls [0-9][0-9]_*.*) )
    for file in "${file_array[@]}"; do
        chmod +x ${file};
        ./${file};
        [[ $? -ne 0 ]] && exit;
    done
done
